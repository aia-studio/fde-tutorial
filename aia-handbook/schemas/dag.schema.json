{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aia-handbook.local/schemas/dag.schema.json",
  "title": "dag.json",
  "description": "plan.py 的产物。依赖图必须由章纲编译，禁止手画。",
  "type": "object",
  "required": ["nodes", "waves"],
  "properties": {
    "book": { "type": "string" },
    "genre": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "nodes": {
      "type": "object",
      "patternProperties": {
        "^ch\\d{2}$": {
          "type": "object",
          "required": ["requires", "references"],
          "additionalProperties": false,
          "properties": {
            "requires": { "type": "array", "items": { "type": "string" } },
            "references": { "type": "array", "items": { "type": "string" } },
            "target_words": { "type": "integer", "minimum": 0 },
            "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        }
      },
      "additionalProperties": false
    },
    "waves": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "metrics": { "type": "object" },
    "problems": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "plan_gates": {
      "type": "object",
      "description": "G4 章纲闸门结论（评审 A4）：problems 阻断编译，warnings 是提示。与 check.py 的 G4 共用一份实现。"
    },
    "writing_waves": {
      "type": "object",
      "description": "写作波次表（SPEC §6.1、评审 B5）：按篇/并发切分，仅用于派活，不改变装配与闸门顺序。"
    },
    "project_curve": {
      "type": "object",
      "description": "capstone 项目推进曲线（SPEC §10/§11、评审 A8）；未声明 project_stage 时为 skipped。"
    }
  }
}
