  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "html": "全程术语速查"
    },
    {
      "type": "p",
      "html": "60 个术语按课程脉络排列。<strong>输入即可筛选</strong>，右侧「第 N 课」可跳回讲解处。背不下来的术语都该回到课程里重跑一遍代码——这才是术语表的正确用法。"
    },
    {
      "type": "glossary",
      "terms": [
        {
          "term": "绑定 (binding)",
          "definition": "名字与对象的关联。赋值就是绑定，不是复制。",
          "order": 3
        },
        {
          "term": "不可变 (immutable)",
          "definition": "创建后不能原地修改：int / str / tuple。",
          "order": 8
        },
        {
          "term": "可变 (mutable)",
          "definition": "可以原地修改：list / dict / set，修改对所有引用可见。",
          "order": 8
        },
        {
          "term": "切片 (slice)",
          "definition": "seq[start:stop:step]，含头不含尾。",
          "order": 6
        },
        {
          "term": "f-string",
          "definition": "f\"...{表达式}...\" 格式化字符串字面量，格式说明在冒号后。",
          "order": 6
        },
        {
          "term": "真值 (truthiness)",
          "definition": "空容器、0、None、False 为假；\"0\"、[0] 为真。",
          "order": 10
        },
        {
          "term": "鸭子类型 (duck typing)",
          "definition": "只看行为（有没有这个方法），不看继承关系。",
          "order": 60
        },
        {
          "term": "海象运算符 (:=)",
          "definition": "在表达式内部赋值，常见于循环条件。",
          "order": 11
        },
        {
          "term": "match/case",
          "definition": "结构化模式匹配，匹配形状而非相等。",
          "order": 11
        },
        {
          "term": "EAFP",
          "definition": "Easier to Ask Forgiveness than Permission：先做，出异常再处理。",
          "order": 29
        },
        {
          "term": "生成器 (generator)",
          "definition": "带 yield 的函数，惰性产出、只能遍历一次。",
          "order": 28
        },
        {
          "term": "生成器表达式",
          "definition": "(x for x in seq)：推导式的惰性版本。",
          "order": 13
        },
        {
          "term": "惰性求值 (lazy)",
          "definition": "用到才计算，不预先建整块数据。",
          "order": 13
        },
        {
          "term": "闭包 (closure)",
          "definition": "函数 + 它捕获的外层变量；变量活在 cell 里。",
          "order": 17
        },
        {
          "term": "晚绑定 (late binding)",
          "definition": "闭包捕获的是变量而非值，调用时才读取。",
          "order": 17
        },
        {
          "term": "LEGB",
          "definition": "作用域查找顺序：Local → Enclosing → Global → Builtin。",
          "order": 16
        },
        {
          "term": "nonlocal",
          "definition": "声明“修改外层函数的变量”。",
          "order": 16
        },
        {
          "term": "UnboundLocalError",
          "definition": "在函数内读“已赋值”的局部名之前——通常是忘了 global。",
          "order": 16
        },
        {
          "term": "装饰器 (decorator)",
          "definition": "@deco ≡ func = deco(func)，在定义时包装函数。",
          "order": 40
        },
        {
          "term": "functools.wraps",
          "definition": "装饰器必备，保留被装饰函数的名字与文档。",
          "order": 40
        },
        {
          "term": "lru_cache",
          "definition": "按参数缓存函数结果；只适合纯函数。",
          "order": 43
        },
        {
          "term": "partial",
          "definition": "预填一部分参数，生成新函数。",
          "order": 43
        },
        {
          "term": "singledispatch",
          "definition": "按参数类型分发到不同实现。",
          "order": 43
        },
        {
          "term": "Counter",
          "definition": "计数容器，缺键返回 0，自带 most_common。",
          "order": 44
        },
        {
          "term": "defaultdict",
          "definition": "缺键时调用工厂函数补默认值。",
          "order": 44
        },
        {
          "term": "deque",
          "definition": "两端操作 O(1) 的队列，maxlen 可自动滑窗。",
          "order": 44
        },
        {
          "term": "dataclass",
          "definition": "按字段注解生成 __init__/__repr__/__eq__。",
          "order": 35
        },
        {
          "term": "frozen",
          "definition": "不可变 dataclass，实例可哈希。",
          "order": 35
        },
        {
          "term": "property",
          "definition": "把方法伪装成属性，读取即计算。",
          "order": 36
        },
        {
          "term": "__slots__",
          "definition": "固定属性槽位，省内存、禁动态属性。",
          "order": 36
        },
        {
          "term": "描述符 (descriptor)",
          "definition": "实现 __get__/__set__ 的协议，property 与方法绑定的基础。",
          "order": 75
        },
        {
          "term": "元类 (metaclass)",
          "definition": "创建类的类；99% 的需求用 __init_subclass__ 就够。",
          "order": 77
        },
        {
          "term": "__init_subclass__",
          "definition": "子类定义时自动触发的钩子，注册表首选。",
          "order": 77
        },
        {
          "term": "MRO",
          "definition": "方法解析顺序（C3 线性化），__mro__ 可查。",
          "order": 78
        },
        {
          "term": "Mixin",
          "definition": "小而正交、不独立实例化的能力类。",
          "order": 78
        },
        {
          "term": "泛型 (generic)",
          "definition": "class Stack[T]：类型参数随容器传递。",
          "order": 79
        },
        {
          "term": "协变/逆变",
          "definition": "只读容器协变（Sequence）、可写容器不变（list）。",
          "order": 79
        },
        {
          "term": "Protocol",
          "definition": "结构化子类型：长得像就算，不必显式继承。",
          "order": 48
        },
        {
          "term": "ABC",
          "definition": "抽象基类：名义契约，实例化时强制检查抽象方法。",
          "order": 48
        },
        {
          "term": "类型收窄 (narrowing)",
          "definition": "is None 判断后，分支内类型确定。",
          "order": 58
        },
        {
          "term": "ExceptionGroup",
          "definition": "一组异常，except* 按类型分支处理。",
          "order": 85
        },
        {
          "term": "GIL",
          "definition": "全局解释器锁：同一时刻一个线程执行字节码。",
          "order": 67
        },
        {
          "term": "事件循环 (event loop)",
          "definition": "asyncio 的调度器，在 await 处切换任务。",
          "order": 70
        },
        {
          "term": "协作式调度",
          "definition": "任务只在 await 处让出控制权。",
          "order": 70
        },
        {
          "term": "TaskGroup",
          "definition": "结构化并发：全部等完、一败俱败。",
          "order": 71
        },
        {
          "term": "Semaphore",
          "definition": "限制同时运行的并发数。",
          "order": 71
        },
        {
          "term": "ContextVar",
          "definition": "按任务隔离的“全局变量”，日志注入 request-id 的标准做法。",
          "order": 72
        },
        {
          "term": "字节码 (bytecode)",
          "definition": "源码编译后的虚拟机指令，dis 可查看。",
          "order": 83
        },
        {
          "term": "常量折叠 (folding)",
          "definition": "编译期算好常量表达式。",
          "order": 83
        },
        {
          "term": "循环导入 (circular import)",
          "definition": "互相 import 读到半成品模块，报错点在半成品属性。",
          "order": 84
        },
        {
          "term": "__all__",
          "definition": "import * 的白名单声明。",
          "order": 84
        },
        {
          "term": "venv",
          "definition": "每个项目独立的 site-packages。",
          "order": 30
        },
        {
          "term": "wheel",
          "definition": "预构建的安装包，pip 优先安装。",
          "order": 62
        },
        {
          "term": "入口点 (entry point)",
          "definition": "安装后生成的命令，指向 模块:函数。",
          "order": 62
        },
        {
          "term": "竞态条件 (race condition)",
          "definition": "多线程时序导致的错误结果，用 Lock 消除。",
          "order": 67
        },
        {
          "term": "cProfile",
          "definition": "函数级热点分析，tottime 排序找瓶颈。",
          "order": 65
        },
        {
          "term": "timeit",
          "definition": "关 GC 的微基准，量级对比用。",
          "order": 64
        },
        {
          "term": "深拷贝 (deepcopy)",
          "definition": "递归复制整棵对象图，防止内层穿透。",
          "order": 53
        },
        {
          "term": "弃用 (deprecation)",
          "definition": "功能标记为将移除，用 warnings.warn 提醒。",
          "order": 92
        }
      ]
    },
    {
      "type": "callout",
      "kind": "tip",
      "title": "用法建议",
      "html": "筛选框支持拼音外的一切子串（术语、定义都搜）。碰到陌生术语，先筛选、跳课程、重跑代码——比背定义有效得多。"
    }
  ],
  "prev": "s4-96-c-api",
  "next": "s5-98-pep-guide"
}